{
  "expo": {
    "name": "PRO Инсульт",
    "slug": "pro-insult",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ru.proinsult.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#79B0FB",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ru.proinsult.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "Камера нужна, чтобы проверять, как вы выполняете упражнения. Видео не записывается и никуда не отправляется.",
          "recordAudioAndroid": false
        }
      ],
      "expo-image"
    ],
    "scheme": "proinsult",
    "experiments": {
      "typedRoutes": true
    }
  }
}
